# Public site URL (used for canonical URLs, Open Graph and the sitemap)
VITE_SITE_URL=https://www.indoyug.in

# Endpoint that receives enquiry submissions (POST, multipart/form-data).
# Leave empty until the backend is deployed — forms will then show a clear
# "submission service not configured" error instead of a fake success.
VITE_ENQUIRY_ENDPOINT=

# Optional: Google Maps embed is keyless; no secret keys belong in VITE_* vars,
# because everything prefixed VITE_ is shipped to the browser.

